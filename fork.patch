@@ -0,0 +1,280 @@
+package org.telegram.ui;
+
+import android.content.Context;
+import android.text.InputType;
+import android.text.TextUtils;
+import android.util.TypedValue;
+import android.view.View;
+import android.view.ViewGroup;
+import android.view.inputmethod.EditorInfo;
+import android.widget.EditText;
+import android.widget.FrameLayout;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ForkPlugin;
+import org.telegram.messenger.ForkPluginManager;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.ActionBar;
+import org.telegram.ui.ActionBar.AlertDialog;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Cells.HeaderCell;
+import org.telegram.ui.Cells.TextCheckCell;
+import org.telegram.ui.Cells.TextInfoPrivacyCell;
+import org.telegram.ui.Cells.TextSettingsCell;
+import org.telegram.ui.Components.AlertsCreator;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.RecyclerListView;
+
+import java.util.ArrayList;
+
+public class ForkPluginSettingsActivity extends BaseFragment {
+    private static final int TYPE_CHECK = 0;
+    private static final int TYPE_SECTION = 1;
+    private static final int TYPE_SWITCH = 2;
+    private static final int TYPE_TEXT = 3;
+    private static final int TYPE_ACTION = 4;
+    private static final int TYPE_INFO = 5;
+
+    private static final int ROW_ENABLED = 0;
+    private static final int ROW_FIRST = 1;
+
+    private final String pluginId;
+    private final ArrayList<ForkPlugin.Row> rows = new ArrayList<>();
+
+    private ForkPlugin plugin;
+    private RecyclerListView listView;
+    private ListAdapter adapter;
+
+    public ForkPluginSettingsActivity(String pluginId) {
+        this.pluginId = pluginId;
+    }
+
+    @Override
+    public View createView(Context context) {
+        plugin = ForkPluginManager.getInstance().find(pluginId);
+
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setAllowOverlayTitle(true);
+        actionBar.setTitle(plugin != null ? plugin.name : LocaleController.getString(R.string.ForkPlugins));
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) {
+                    finishFragment();
+                } else if (id == 1) {
+                    if (plugin != null) {
+                        confirmDelete();
+                    }
+                }
+            }
+        });
+        if (plugin != null) {
+            actionBar.createMenu().addItem(1, R.drawable.iv_media_delete);
+        }
+
+        FrameLayout frameLayout = new FrameLayout(context);
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+        fragmentView = frameLayout;
+
+        listView = new RecyclerListView(context);
+        actionBar.setAdaptiveBackground(listView);
+        listView.setLayoutManager(new LinearLayoutManager(context));
+        listView.setVerticalScrollBarEnabled(false);
+        listView.setAdapter(adapter = new ListAdapter(context));
+        listView.setOnItemClickListener((view, position) -> onRowClicked(position));
+        frameLayout.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+
+        load();
+        return fragmentView;
+    }
+
+    private void load() {
+        rows.clear();
+        if (plugin != null && plugin.enabled) {
+            ForkPluginManager.getInstance().run(plugin);
+            if (plugin.rows != null) {
+                rows.addAll(plugin.rows);
+            }
+        }
+        if (adapter != null) {
+            adapter.notifyDataSetChanged();
+        }
+    }
+
+    private void onRowClicked(int position) {
+        if (plugin == null) {
+            finishFragment();
+            return;
+        }
+        if (position == ROW_ENABLED) {
+            ForkPluginManager.getInstance().setEnabled(plugin, !plugin.enabled);
+            load();
+            return;
+        }
+        int index = position - ROW_FIRST;
+        if (index < 0 || index >= rows.size()) {
+            return;
+        }
+        ForkPlugin.Row row = rows.get(index);
+        if (row.type == ForkPlugin.TYPE_SWITCH) {
+            boolean value = !ForkPluginManager.getInstance().getFlag(plugin.id, row.key, false);
+            ForkPluginManager.getInstance().setFlag(plugin.id, row.key, value);
+            load();
+        } else if (row.type == ForkPlugin.TYPE_TEXT) {
+            showTextDialog(row);
+        } else if (row.type == ForkPlugin.TYPE_ACTION) {
+            ForkPluginManager.getInstance().callAction(plugin, row.action);
+            load();
+        }
+    }
+
+    private void showTextDialog(ForkPlugin.Row row) {
+        Context context = getParentActivity();
+        if (context == null) {
+            return;
+        }
+        final EditText editText = new EditText(context);
+        editText.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText));
+        editText.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText));
+        editText.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16);
+        editText.setBackground(Theme.createEditTextDrawable(context, true));
+        editText.setText(ForkPluginManager.getInstance().getText(plugin.id, row.key, row.value));
+        editText.setSingleLine(true);
+        editText.setInputType(InputType.TYPE_CLASS_TEXT);
+        editText.setImeOptions(EditorInfo.IME_ACTION_DONE);
+        editText.setPadding(AndroidUtilities.dp(16), AndroidUtilities.dp(8), AndroidUtilities.dp(16), AndroidUtilities.dp(8));
+
+        AlertDialog.Builder builder = new AlertDialog.Builder(context);
+        builder.setTitle(row.title);
+        builder.setView(editText);
+        builder.setPositiveButton(LocaleController.getString(R.string.OK), (dialog, which) -> {
+            ForkPluginManager.getInstance().setText(plugin.id, row.key, editText.getText().toString());
+            load();
+        });
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null);
+        showDialog(builder.create());
+    }
+
+    private void confirmDelete() {
+        AlertsCreator.showSimpleConfirmAlert(this,
+                LocaleController.getString(R.string.ForkPluginDelete),
+                LocaleController.getString(R.string.ForkPluginDeleteConfirm),
+                LocaleController.getString(R.string.Delete), true, () -> {
+                    ForkPluginManager.getInstance().delete(plugin);
+                    finishFragment();
+                });
+    }
+
+    private class ListAdapter extends RecyclerListView.SelectionAdapter {
+        private final Context context;
+
+        private ListAdapter(Context context) {
+            this.context = context;
+        }
+
+        @Override
+        public int getItemCount() {
+            return plugin == null ? 0 : rows.size() + ROW_FIRST + 1;
+        }
+
+        @Override
+        public boolean isEnabled(RecyclerView.ViewHolder holder) {
+            int position = holder.getAdapterPosition();
+            if (position == ROW_ENABLED) {
+                return true;
+            }
+            int index = position - ROW_FIRST;
+            if (index < 0 || index >= rows.size()) {
+                return false;
+            }
+            int type = rows.get(index).type;
+            return type == ForkPlugin.TYPE_SWITCH || type == ForkPlugin.TYPE_TEXT || type == ForkPlugin.TYPE_ACTION;
+        }
+
+        @NonNull
+        @Override
+        public RecyclerView.ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+            View view;
+            switch (viewType) {
+                case TYPE_CHECK:
+                    view = new TextCheckCell(context);
+                    break;
+                case TYPE_SECTION:
+                    view = new HeaderCell(context);
+                    break;
+                case TYPE_INFO:
+                    view = new TextInfoPrivacyCell(context);
+                    break;
+                default:
+                    TextSettingsCell cell = new TextSettingsCell(context);
+                    cell.setCanDisable(false);
+                    view = cell;
+                    break;
+            }
+            view.setLayoutParams(new RecyclerView.LayoutParams(RecyclerView.LayoutParams.MATCH_PARENT, RecyclerView.LayoutParams.WRAP_CONTENT));
+            return new RecyclerListView.Holder(view);
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull RecyclerView.ViewHolder holder, int position) {
+            int type = getItemViewType(position);
+            if (type == TYPE_CHECK) {
+                TextCheckCell cell = (TextCheckCell) holder.itemView;
+                cell.setTextAndCheck(LocaleController.getString(R.string.ForkPluginEnabled), plugin.enabled, false);
+            } else if (type == TYPE_SECTION) {
+                HeaderCell cell = (HeaderCell) holder.itemView;
+                cell.setText(rows.get(position - ROW_FIRST).title);
+            } else if (type == TYPE_INFO) {
+                TextInfoPrivacyCell cell = (TextInfoPrivacyCell) holder.itemView;
+                if (!TextUtils.isEmpty(plugin.error)) {
+                    cell.setText(LocaleController.getString(R.string.ForkPluginError) + ": " + plugin.error);
+                } else if (!TextUtils.isEmpty(plugin.description)) {
+                    cell.setText(plugin.description);
+                } else {
+                    cell.setText(LocaleController.getString(R.string.ForkPluginNoSettings));
+                }
+            } else {
+                ForkPlugin.Row row = rows.get(position - ROW_FIRST);
+                TextSettingsCell cell = (TextSettingsCell) holder.itemView;
+                if (row.type == ForkPlugin.TYPE_SWITCH) {
+                    boolean value = ForkPluginManager.getInstance().getFlag(plugin.id, row.key, false);
+                    cell.setTextAndValue(row.title, value ? LocaleController.getString(R.string.ForkPluginOn) : LocaleController.getString(R.string.ForkPluginOff), false);
+                } else if (row.type == ForkPlugin.TYPE_TEXT) {
+                    String value = ForkPluginManager.getInstance().getText(plugin.id, row.key, row.value);
+                    cell.setTextAndValue(row.title, value, false);
+                } else {
+                    cell.setTextAndValue(row.title, LocaleController.getString(R.string.ForkPluginRun), false);
+                }
+            }
+        }
+
+        @Override
+        public int getItemViewType(int position) {
+            if (position == ROW_ENABLED) {
+                return TYPE_CHECK;
+            }
+            int index = position - ROW_FIRST;
+            if (index >= rows.size()) {
+                return TYPE_INFO;
+            }
+            switch (rows.get(index).type) {
+                case ForkPlugin.TYPE_SECTION:
+                    return TYPE_SECTION;
+                case ForkPlugin.TYPE_SWITCH:
+                    return TYPE_SWITCH;
+                case ForkPlugin.TYPE_TEXT:
+                    return TYPE_TEXT;
+                case ForkPlugin.TYPE_ACTION:
+                    return TYPE_ACTION;
+                default:
+                    return TYPE_INFO;
+            }
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ForkPluginsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ForkPluginsActivity.java
