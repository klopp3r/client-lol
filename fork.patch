--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ForkGhostActivity.java
@@ -0,0 +1,226 @@
+package org.telegram.ui;
+
+import android.content.Context;
+import android.view.Gravity;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.Switch;
+
+import androidx.annotation.NonNull;
+import androidx.recyclerview.widget.LinearLayoutManager;
+import androidx.recyclerview.widget.RecyclerView;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ForkGhost;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+import org.telegram.ui.ActionBar.ActionBar;
+import org.telegram.ui.ActionBar.BaseFragment;
+import org.telegram.ui.ActionBar.Theme;
+import org.telegram.ui.Cells.TextInfoPrivacyCell;
+import org.telegram.ui.Cells.TextSettingsCell;
+import org.telegram.ui.Components.LayoutHelper;
+import org.telegram.ui.Components.RecyclerListView;
+
+/**
+ * «Настройки Huntergram» — список переключателей режима призрака.
+ * Каждый пункт сохраняется сразу, главный выключатель отключает остальные.
+ */
+public class ForkGhostActivity extends BaseFragment {
+    private static final int TYPE_SWITCH = 0;
+    private static final int TYPE_INFO = 1;
+
+    private static final int ROW_ENABLED = 0;
+    private static final int ROW_READ = 1;
+    private static final int ROW_HISTORY = 2;
+    private static final int ROW_ONLINE = 3;
+    private static final int ROW_TYPING = 4;
+    private static final int ROW_AUTO_OFFLINE = 5;
+    private static final int ROW_COUNT = 6;
+
+    private RecyclerListView listView;
+    private ListAdapter adapter;
+    private boolean enabled;
+
+    @Override
+    public View createView(Context context) {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setTitle(LocaleController.getString(R.string.ForkHuntergramSettings));
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) {
+                    finishFragment();
+                }
+            }
+        });
+
+        FrameLayout frameLayout = new FrameLayout(context);
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+        fragmentView = frameLayout;
+
+        listView = new RecyclerListView(context);
+        actionBar.setAdaptiveBackground(listView);
+        listView.setLayoutManager(new LinearLayoutManager(context));
+        listView.setVerticalScrollBarEnabled(false);
+        listView.setAdapter(adapter = new ListAdapter(context));
+        frameLayout.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+
+        refresh();
+        return fragmentView;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        refresh();
+    }
+
+    private void refresh() {
+        enabled = ForkGhost.isEnabled();
+        if (adapter != null) {
+            // notifyItemRangeChanged запускает анимацию изменения строк,
+            // а notifyDataSetChanged перерисовывает всё без перехода.
+            adapter.notifyItemRangeChanged(0, adapter.getItemCount());
+        }
+    }
+
+    private void toggle(final int row, boolean value) {
+        switch (row) {
+            case ROW_ENABLED: {
+                ForkGhost.setEnabled(value);
+                break;
+            }
+            case ROW_READ: {
+                ForkGhost.setBlockRead(value);
+                break;
+            }
+            case ROW_HISTORY: {
+                ForkGhost.setBlockHistory(value);
+                break;
+            }
+            case ROW_ONLINE: {
+                ForkGhost.setBlockOnline(value);
+                break;
+            }
+            case ROW_TYPING: {
+                ForkGhost.setBlockTyping(value);
+                break;
+            }
+            case ROW_AUTO_OFFLINE: {
+                ForkGhost.setAutoOffline(value);
+                break;
+            }
+        }
+        refresh();
+    }
+
+    private CharSequence title(int row) {
+        switch (row) {
+            case ROW_ENABLED: return LocaleController.getString(R.string.ForkGhostEnabled);
+            case ROW_READ: return LocaleController.getString(R.string.ForkGhostRead);
+            case ROW_HISTORY: return LocaleController.getString(R.string.ForkGhostHistory);
+            case ROW_ONLINE: return LocaleController.getString(R.string.ForkGhostOnline);
+            case ROW_TYPING: return LocaleController.getString(R.string.ForkGhostTyping);
+            case ROW_AUTO_OFFLINE: return LocaleController.getString(R.string.ForkGhostAutoOffline);
+        }
+        return "";
+    }
+
+    private boolean checked(int row) {
+        switch (row) {
+            case ROW_ENABLED: return ForkGhost.isEnabled();
+            case ROW_READ: return ForkGhost.isBlockRead();
+            case ROW_HISTORY: return ForkGhost.isBlockHistory();
+            case ROW_ONLINE: return ForkGhost.isBlockOnline();
+            case ROW_TYPING: return ForkGhost.isBlockTyping();
+            case ROW_AUTO_OFFLINE: return ForkGhost.isAutoOffline();
+        }
+        return false;
+    }
+
+    private class SwitchHolder extends RecyclerListView.Holder {
+        final Switch toggle;
+
+        SwitchHolder(View itemView, Switch toggle) {
+            super(itemView);
+            this.toggle = toggle;
+        }
+    }
+
+    private class ListAdapter extends RecyclerListView.SelectionAdapter {
+        private final Context context;
+
+        private ListAdapter(Context context) {
+            this.context = context;
+        }
+
+        @Override
+        public int getItemCount() {
+            return ROW_COUNT + 1;
+        }
+
+        @Override
+        public boolean isEnabled(RecyclerView.ViewHolder holder) {
+            return !(holder instanceof SwitchHolder);
+        }
+
+        @NonNull
+        @Override
+        public RecyclerView.ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+            View item;
+            if (viewType == TYPE_SWITCH) {
+                FrameLayout container = new FrameLayout(context);
+                TextSettingsCell cell = new TextSettingsCell(context);
+                cell.setCanDisable(false);
+                cell.setText(LocaleController.getString(R.string.ForkGhostPlaceholder), true);
+                container.addView(cell, new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+                Switch toggle = new Switch(context);
+                FrameLayout.LayoutParams toggleParams = new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER_VERTICAL | Gravity.END);
+                toggleParams.rightMargin = AndroidUtilities.dp(16);
+                container.addView(toggle, toggleParams);
+                item = container;
+                item.setLayoutParams(new RecyclerView.LayoutParams(
+                        RecyclerView.LayoutParams.MATCH_PARENT, RecyclerView.LayoutParams.WRAP_CONTENT));
+                return new SwitchHolder(item, toggle);
+            }
+            item = new TextInfoPrivacyCell(context);
+            item.setLayoutParams(new RecyclerView.LayoutParams(
+                    RecyclerView.LayoutParams.MATCH_PARENT, RecyclerView.LayoutParams.WRAP_CONTENT));
+            return new RecyclerListView.Holder(item);
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull RecyclerView.ViewHolder holder, int position) {
+            if (position == ROW_COUNT) {
+                TextInfoPrivacyCell cell = (TextInfoPrivacyCell) holder.itemView;
+                cell.setText(enabled
+                        ? LocaleController.getString(R.string.ForkGhostInfo)
+                        : LocaleController.getString(R.string.ForkGhostOff));
+                return;
+            }
+            SwitchHolder switchHolder = (SwitchHolder) holder;
+            ((TextSettingsCell) ((FrameLayout) holder.itemView).getChildAt(0)).setText(title(position), true);
+            // Состояние выставляем до слушателя, иначе recycled-ячейка
+            // «щёлкнет» переключателем при прокрутке.
+            switchHolder.toggle.setOnCheckedChangeListener(null);
+            switchHolder.toggle.setChecked(checked(position));
+            switchHolder.toggle.setEnabled(enabled || position == ROW_ENABLED);
+            switchHolder.toggle.setAlpha(enabled || position == ROW_ENABLED ? 1f : 0.5f);
+            switchHolder.toggle.setOnCheckedChangeListener((button, isChecked) -> {
+                if (isChecked != checked(position)) {
+                    toggle(position, isChecked);
+                }
+            });
+        }
+
+        @Override
+        public int getItemViewType(int position) {
+            return position == ROW_COUNT ? TYPE_INFO : TYPE_SWITCH;
+        }
+    }
+}
