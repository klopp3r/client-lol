+package org.telegram.ui;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.widget.Toast;
+
+import org.telegram.messenger.AndroidUtilities;
+import org.telegram.messenger.ForkPlugin;
+import org.telegram.messenger.ForkPluginManager;
+import org.telegram.messenger.LocaleController;
+import org.telegram.messenger.R;
+
+/**
+ * Точка входа для «Открыть с помощью»: файлы .js и .plugin, выбранные в
+ * файловом менеджере или браузере, устанавливаются сразу, без ручного
+ * выбора через системный выбор файла. Активность прозрачная — пользователь
+ * видит только подтверждение и открытое приложение.
+ */
+public class ForkPluginInstallActivity extends Activity {
+    @Override
+    protected void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+
+        Intent intent = getIntent();
+        final Uri uri = intent == null ? null : intent.getData();
+        if (uri == null) {
+            finish();
+            return;
+        }
+
+        new Thread(() -> {
+            String message = null;
+            String name = null;
+            try {
+                ForkPlugin plugin = ForkPluginManager.getInstance().install(this, uri);
+                name = plugin != null ? plugin.name : null;
+            } catch (Throwable t) {
+                message = t.getMessage() != null ? t.getMessage() : t.getClass().getSimpleName();
+            }
+            final String pluginName = name;
+            final String error = message;
+            AndroidUtilities.runOnUIThread(() -> {
+                if (error != null) {
+                    showToast(getString(R.string.ForkPluginInstallError, error));
+                } else {
+                    showToast(getString(R.string.ForkPluginInstallOk, pluginName != null ? pluginName : ""));
+                }
+                openApp();
+            });
+        }).start();
+    }
+
+    private void showToast(String text) {
+        try {
+            Toast.makeText(this, text, Toast.LENGTH_LONG).show();
+        } catch (Throwable ignored) {
+        }
+    }
+
+    private void openApp() {
+        try {
+            Intent launch = getPackageManager().getLaunchIntentForPackage(getPackageName());
+            if (launch != null) {
+                launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                startActivity(launch);
+            }
+        } catch (Throwable ignored) {
+        }
+        finish();
+    }
+}
