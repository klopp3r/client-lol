+    private void presentForkCrashReport() {
+        final Context parent = getParentActivity();
+        final String error = ForkDiagnostics.getLastError(parent);
+        final long start = ForkDiagnostics.getLastStart(parent);
+        String time = "-";
+        if (start > 0) {
+            time = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm", java.util.Locale.US)
+                    .format(new java.util.Date(start));
+        }
+        StringBuilder builder = new StringBuilder();
+        builder.append(getString(R.string.ForkLastLaunch)).append(": ").append(time);
+        if (!TextUtils.isEmpty(error)) {
+            builder.append("\n\n").append(error);
+        } else {
+            builder.append("\n\n").append(getString(R.string.ForkNoCrash));
         }
+        new AlertDialog.Builder(parent, resourceProvider)
+            .setTitle(getString(R.string.ForkCrashReport))
+            .setMessage(builder.toString())
+            .setPositiveButton(getString(R.string.OK), null)
+            .setNeutralButton(getString(R.string.ForkClearReport), (dialog, which) -> ForkDiagnostics.clear(parent))
+            .show();
     }
 
