+package org.telegram.messenger;
+
+import android.text.TextUtils;
+import android.widget.Toast;
+
+import org.mozilla.javascript.Function;
+
+public class ForkPluginApi {
+    private final ForkPlugin plugin;
+
+    public ForkPluginApi(ForkPlugin plugin) {
+        this.plugin = plugin;
+    }
+
+    public String getPluginId() {
+        return plugin.id;
+    }
+
+    public String getPluginName() {
+        return plugin.name;
+    }
+
+    public String getPluginVersion() {
+        return plugin.version;
+    }
+
+    public void log(String message) {
+        FileLog.d("[plugin " + plugin.id + "] " + message);
+    }
+
+    public void setFlag(String key, boolean value) {
+        ForkPluginManager.getInstance().setFlag(plugin.id, key, value);
+    }
+
+    public boolean getFlag(String key, boolean def) {
+        return ForkPluginManager.getInstance().getFlag(plugin.id, key, def);
+    }
+
+    public void setText(String key, String value) {
+        ForkPluginManager.getInstance().setText(plugin.id, key, value);
+    }
+
+    public String getText(String key, String def) {
+        return ForkPluginManager.getInstance().getText(plugin.id, key, def);
+    }
+
+    public void addSection(String title) {
+        plugin.rows.add(new ForkPlugin.Row(ForkPlugin.TYPE_SECTION, null, title, null, null, null));
+    }
+
+    public void addSwitch(String key, String title, boolean def, String summary) {
+        plugin.rows.add(new ForkPlugin.Row(ForkPlugin.TYPE_SWITCH, key, title, summary, null, null));
+    }
+
+    public void addSwitch(String key, String title, boolean def) {
+        addSwitch(key, title, def, null);
+    }
+
+    public void addText(String key, String title, String def, String summary) {
+        plugin.rows.add(new ForkPlugin.Row(ForkPlugin.TYPE_TEXT, key, title, summary, def, null));
+    }
+
+    public void addText(String key, String title, String def) {
+        addText(key, title, def, null);
+    }
+
+    public void addInfo(String text) {
+        plugin.rows.add(new ForkPlugin.Row(ForkPlugin.TYPE_INFO, null, text, null, null, null));
+    }
+
+    public void addAction(String title, String summary, Function onClick) {
+        plugin.rows.add(new ForkPlugin.Row(ForkPlugin.TYPE_ACTION, null, title, summary, null, onClick));
+    }
+
+    public void addAction(String title, Function onClick) {
+        addAction(title, null, onClick);
+    }
+
+    public void toast(final String text) {
+        if (TextUtils.isEmpty(text)) {
+            return;
+        }
+        AndroidUtilities.runOnUIThread(new Runnable() {
+            @Override
+            public void run() {
+                Toast.makeText(ApplicationLoader.applicationContext, text, Toast.LENGTH_SHORT).show();
+            }
+        });
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/ForkPluginManager.java b/TMessagesProj/src/main/java/org/telegram/messenger/ForkPluginManager.java
new file mode 100644
index 0000000..b1da232
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ForkPluginManager.java
@@ -0,0 +1,434 @@
+package org.telegram.messenger;
+
+import android.content.SharedPreferences;
+import android.database.Cursor;
+import android.net.Uri;
+import android.provider.OpenableColumns;
+import android.text.TextUtils;
+
+import org.json.JSONObject;
+import org.mozilla.javascript.ClassShutter;
+import org.mozilla.javascript.Context;
+import org.mozilla.javascript.ContextFactory;
+import org.mozilla.javascript.Function;
+import org.mozilla.javascript.Scriptable;
+import org.mozilla.javascript.ScriptableObject;
+import org.mozilla.javascript.WrapFactory;
+
+import java.io.ByteArrayOutputStream;
+import java.io.File;
+import java.io.FileInputStream;
+import java.io.FileOutputStream;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.util.ArrayList;
+import java.util.Arrays;
+import java.util.Comparator;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+public class ForkPluginManager {
+    public static final int MAX_SOURCE_SIZE = 512 * 1024;
+    public static final long MAX_STEPS = 2_000_000L;
+
+    private static final String PREFS = "fork_plugins";
+    private static final String DIR = "fork-plugins";
+    private static final String TAG = "@fork-plugin";
+
+    private static final Set<String> DENIED = new HashSet<>(Arrays.asList(
+            "java.lang.Runtime",
+            "java.lang.ProcessBuilder",
+            "java.lang.Class",
+            "java.lang.ClassLoader",
+            "java.lang.System",
+            "java.lang.Thread",
+            "java.lang.ThreadGroup",
+            "java.lang.Module",
+            "java.lang.StackTraceElement"
+    ));
+
+    private static final class ForkContext extends Context {
+        private long steps;
+
+        @Override
+        protected void observeInstructionCount(int instructionCount) {
+            steps += instructionCount;
+            if (steps > MAX_STEPS) {
+                throw new IllegalStateException("plugin exceeded the instruction limit");
+            }
+        }
+    }
+
+    private static final WrapFactory WRAP_FACTORY = new WrapFactory();
+
+    static {
+        WRAP_FACTORY.setJavaPrimitiveWrap(false);
+    }
+
+    private static final ContextFactory FACTORY = new ContextFactory() {
+        @Override
+        protected Context makeContext() {
+            return new ForkContext();
+        }
+    };
+
+    private static final ClassShutter SHUTTER = new ClassShutter() {
+        @Override
+        public boolean visibleToScripts(String fullClassName) {
+            if (fullClassName.startsWith("org.mozilla.javascript.")) {
+                return true;
+            }
+            if (fullClassName.startsWith("org.json.")) {
+                return true;
+            }
+            if (fullClassName.equals("org.telegram.messenger.ForkPluginApi")
+                    || fullClassName.equals("org.telegram.messenger.ForkPlugin")
+                    || fullClassName.equals("org.telegram.messenger.ForkPlugin$Row")) {
+                return true;
+            }
+            if (fullClassName.startsWith("java.lang.")) {
+                return !DENIED.contains(fullClassName);
+            }
+            return false;
+        }
+    };
+
+    private static volatile ForkPluginManager instance;
+
+    private final ArrayList<ForkPlugin> plugins = new ArrayList<>();
+    private final ArrayList<Runnable> listeners = new ArrayList<>();
+    private boolean loaded;
+
+    public static ForkPluginManager getInstance() {
+        if (instance == null) {
+            synchronized (ForkPluginManager.class) {
+                if (instance == null) {
+                    instance = new ForkPluginManager();
+                }
+            }
+        }
+        return instance;
+    }
+
+    private SharedPreferences prefs() {
+        return ApplicationLoader.applicationContext.getSharedPreferences(PREFS, android.content.Context.MODE_PRIVATE);
+    }
+
+    private File dir() {
+        File dir = new File(ApplicationLoader.applicationContext.getFilesDir(), DIR);
+        if (!dir.exists()) {
+            dir.mkdirs();
+        }
+        return dir;
+    }
+
+    public synchronized ArrayList<ForkPlugin> loadPlugins() {
+        if (loaded) {
+            return plugins;
+        }
+        loaded = true;
+        File[] files = dir().listFiles();
+        if (files != null) {
+            Arrays.sort(files, new Comparator<File>() {
+                @Override
+                public int compare(File a, File b) {
+                    return a.getName().compareTo(b.getName());
+                }
+            });
+            for (int i = 0; i < files.length; i++) {
+                if (files[i].isFile() && files[i].getName().endsWith(".js")) {
+                    plugins.add(parse(files[i]));
+                }
+            }
+        }
+        return plugins;
+    }
+
+    public synchronized ForkPlugin find(String id) {
+        if (id == null) {
+            return null;
+        }
+        for (int i = 0; i < loadPlugins().size(); i++) {
+            if (id.equals(loadPlugins().get(i).id)) {
+                return loadPlugins().get(i);
+            }
+        }
+        return null;
+    }
+
+    public synchronized void reload() {
+        loaded = false;
+        plugins.clear();
+        loadPlugins();
+        notifyListeners();
+    }
+
+    public void addListener(Runnable listener) {
+        synchronized (listeners) {
+            listeners.add(listener);
+        }
+    }
+
+    public void removeListener(Runnable listener) {
+        synchronized (listeners) {
+            listeners.remove(listener);
+        }
+    }
+
+    private void notifyListeners() {
+        ArrayList<Runnable> copy;
+        synchronized (listeners) {
+            copy = new ArrayList<>(listeners);
+        }
+        for (int i = 0; i < copy.size(); i++) {
+            copy.get(i).run();
+        }
+    }
+
+    private ForkPlugin parse(File file) {
+        ForkPlugin plugin = new ForkPlugin(file.getName());
+        plugin.id = baseId(file.getName());
+        plugin.name = plugin.id;
+        plugin.enabled = prefs().getBoolean("enabled/" + plugin.id, true);
+        try {
+            String head = readHead(file);
+            int tag = head.indexOf(TAG);
+            int start = tag < 0 ? -1 : head.indexOf('{', tag);
+            if (start >= 0) {
+                int depth = 0;
+                int end = -1;
+                for (int i = start; i < head.length(); i++) {
+                    char c = head.charAt(i);
+                    if (c == '{') {
+                        depth++;
+                    } else if (c == '}') {
+                        depth--;
+                        if (depth == 0) {
+                            end = i + 1;
+                            break;
+                        }
+                    }
+                }
+                if (end > start) {
+                    JSONObject json = new JSONObject(head.substring(start, end));
+                    String id = json.optString("id", "");
+                    if (!TextUtils.isEmpty(id)) {
+                        plugin.id = id;
+                        plugin.enabled = prefs().getBoolean("enabled/" + plugin.id, true);
+                    }
+                    plugin.name = json.optString("name", plugin.id);
+                    plugin.description = json.optString("description", "");
+                    plugin.author = json.optString("author", "");
+                    plugin.version = json.optString("version", "");
+                }
+            }
+        } catch (Throwable t) {
+            plugin.error = describe(t);
+        }
+        return plugin;
+    }
+
+    private static String baseId(String fileName) {
+        String name = fileName;
+        if (name.endsWith(".js")) {
+            name = name.substring(0, name.length() - 3);
+        }
+        return sanitize(name);
+    }
+
+    private static String sanitize(String name) {
+        StringBuilder builder = new StringBuilder();
+        for (int i = 0; i < name.length(); i++) {
+            char c = name.charAt(i);
+            if (Character.isLetterOrDigit(c) || c == '.' || c == '_' || c == '-') {
+                builder.append(c);
+            } else {
+                builder.append('_');
+            }
+        }
+        String result = builder.toString().toLowerCase(Locale.US);
+        return TextUtils.isEmpty(result) ? "plugin" : result;
+    }
+
+    private static String readHead(File file) throws Exception {
+        InputStream in = new FileInputStream(file);
+        try {
+            byte[] buffer = new byte[8192];
+            int read = in.read(buffer);
+            if (read <= 0) {
+                return "";
+            }
+            return new String(buffer, 0, read, "UTF-8");
+        } finally {
+            in.close();
+        }
+    }
+
+    public synchronized ForkPlugin install(android.content.Context context, Uri uri) throws Exception {
+        String display = queryName(context, uri);
+        if (TextUtils.isEmpty(display)) {
+            display = "plugin.js";
+        }
+        if (!display.toLowerCase(Locale.US).endsWith(".js")) {
+            display += ".js";
+        }
+        display = sanitize(display.replace(".js", "")) + ".js";
+
+        InputStream in = context.getContentResolver().openInputStream(uri);
+        if (in == null) {
+            throw new IllegalStateException("cannot open file");
+        }
+        ByteArrayOutputStream out = new ByteArrayOutputStream();
+        try {
+            byte[] buffer = new byte[8192];
+            int read;
+            while ((read = in.read(buffer)) > 0) {
+                out.write(buffer, 0, read);
+                if (out.size() > MAX_SOURCE_SIZE) {
+                    throw new IllegalStateException("file is too large");
+                }
+            }
+        } finally {
+            try {
+                in.close();
+            } catch (Throwable ignored) {
+            }
+        }
+
+        File target = new File(dir(), display);
+        FileOutputStream file = new FileOutputStream(target);
+        try {
+            file.write(out.toByteArray());
+            file.flush();
+        } finally {
+            file.close();
+        }
+
+        reload();
+        return find(baseId(display));
+    }
+
+    private static String queryName(android.content.Context context, Uri uri) {
+        Cursor cursor = null;
+        try {
+            cursor = context.getContentResolver().query(uri, null, null, null, null);
+            if (cursor != null && cursor.moveToFirst()) {
+                int index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME);
+                if (index >= 0) {
+                    return cursor.getString(index);
+                }
+            }
+        } catch (Throwable ignored) {
+        } finally {
+            if (cursor != null) {
+                try {
+                    cursor.close();
+                } catch (Throwable ignored) {
+                }
+            }
+        }
+        return null;
+    }
+
+    public void setEnabled(ForkPlugin plugin, boolean enabled) {
+        plugin.enabled = enabled;
+        prefs().edit().putBoolean("enabled/" + plugin.id, enabled).apply();
+        notifyListeners();
+    }
+
+    public void delete(ForkPlugin plugin) {
+        new File(dir(), plugin.fileName).delete();
+        SharedPreferences.Editor editor = prefs().edit();
+        editor.remove("enabled/" + plugin.id);
+        for (Map.Entry<String, ?> entry : prefs().getAll().entrySet()) {
+            if (entry.getKey() != null && entry.getKey().startsWith(plugin.id + "/")) {
+                editor.remove(entry.getKey());
+            }
+        }
+        editor.apply();
+        reload();
+    }
+
+    public boolean getFlag(String pluginId, String key, boolean def) {
+        return prefs().getBoolean(pluginId + "/" + key, def);
+    }
+
+    public void setFlag(String pluginId, String key, boolean value) {
+        prefs().edit().putBoolean(pluginId + "/" + key, value).apply();
+    }
+
+    public String getText(String pluginId, String key, String def) {
+        return prefs().getString(pluginId + "/" + key, def);
+    }
+
+    public void setText(String pluginId, String key, String value) {
+        prefs().edit().putString(pluginId + "/" + key, value).apply();
+    }
+
+    public void run(final ForkPlugin plugin) {
+        plugin.rows.clear();
+        plugin.error = null;
+        File file = new File(dir(), plugin.fileName);
+        if (!file.exists() || file.length() > MAX_SOURCE_SIZE) {
+            plugin.error = "source file is missing or too large";
+            return;
+        }
+        Context cx = FACTORY.enterContext();
+        try {
+            prepare(cx);
+            Scriptable scope = cx.initStandardObjects();
+            plugin.scope = scope;
+            putApi(cx, scope, plugin);
+            InputStreamReader reader = new InputStreamReader(new FileInputStream(file), "UTF-8");
+            try {
+                cx.evaluateReader(scope, reader, plugin.fileName, 1, null);
+            } finally {
+                reader.close();
+            }
+        } catch (Throwable t) {
+            plugin.error = describe(t);
+        } finally {
+            Context.exit();
+        }
+    }
+
+    public void callAction(ForkPlugin plugin, Object action, Object... args) {
+        if (!(action instanceof Function) || plugin.scope == null) {
+            return;
+        }
+        Context cx = FACTORY.enterContext();
+        try {
+            prepare(cx);
+            Scriptable scope = plugin.scope;
+            putApi(cx, scope, plugin);
+            ((Function) action).call(cx, scope, scope, args == null ? new Object[0] : args);
+        } catch (Throwable t) {
+            plugin.error = describe(t);
+        } finally {
+            Context.exit();
+        }
+    }
+
+    private static void putApi(Context cx, Scriptable scope, ForkPlugin plugin) {
+        ScriptableObject.putProperty(scope, "fork", Context.javaToJS(new ForkPluginApi(plugin), scope));
+    }
+
+    private static void prepare(Context cx) {
+        cx.setWrapFactory(WRAP_FACTORY);
+        cx.setOptimizationLevel(-1);
+        cx.setLanguageVersion(Context.VERSION_ES6);
+        cx.setClassShutter(SHUTTER);
+        cx.setInstructionObserverThreshold(10000);
+    }
+
+    private static String describe(Throwable t) {
+        String name = t.getClass().getSimpleName();
+        String message = t.getMessage();
+        if (TextUtils.isEmpty(message)) {
+            return name;
+        }
+        return name + ": " + message;
+    }
+}
