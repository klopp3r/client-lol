@@ -0,0 +1,64 @@
+package org.telegram.messenger;
+
+import android.text.TextUtils;
+
+import org.mozilla.javascript.Scriptable;
+
+import java.util.ArrayList;
+
+public class ForkPlugin {
+    public static final int TYPE_SECTION = 0;
+    public static final int TYPE_SWITCH = 1;
+    public static final int TYPE_TEXT = 2;
+    public static final int TYPE_INFO = 3;
+    public static final int TYPE_ACTION = 4;
+
+    public final String fileName;
+    public final ArrayList<Row> rows = new ArrayList<>();
+
+    public String id;
+    public String name;
+    public String description;
+    public String author;
+    public String version;
+    public boolean enabled;
+    public String error;
+    public Scriptable scope;
+
+    public ForkPlugin(String fileName) {
+        this.fileName = fileName;
+        this.id = fileName;
+    }
+
+    public String subtitle() {
+        StringBuilder builder = new StringBuilder();
+        if (!TextUtils.isEmpty(version)) {
+            builder.append('v').append(version);
+        }
+        if (!TextUtils.isEmpty(author)) {
+            if (builder.length() > 0) {
+                builder.append(" - ");
+            }
+            builder.append(author);
+        }
+        return builder.toString();
+    }
+
+    public static class Row {
+        public final int type;
+        public final String key;
+        public final String title;
+        public final String summary;
+        public final String value;
+        public final Object action;
+
+        public Row(int type, String key, String title, String summary, String value, Object action) {
+            this.type = type;
+            this.key = key;
+            this.title = title;
+            this.summary = summary;
+            this.value = value;
+            this.action = action;
+        }
+    }
+}
