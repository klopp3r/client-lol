+import org.telegram.ui.Components.RecyclerListView;
+
+/**
+ * «Категории» → «Основные»: числа без округления, время с секундами
+ * и вибрация внутри приложения. Настройки применяются сразу.
+ */
+public class ForkMainSettingsActivity extends BaseFragment {
+    private static final int TYPE_SWITCH = 0;
+    private static final int TYPE_VALUE = 1;
+    private static final int TYPE_INFO = 2;
+
+    private static final int ROW_NO_ROUND = 0;
+    private static final int ROW_SECONDS = 1;
+    private static final int ROW_VIBRATION = 2;
+    private static final int ROW_ANIMATION = 3;
+    private static final int ROW_COUNT = 4;
+
+    private RecyclerListView listView;
+    private ListAdapter adapter;
+
+    @Override
+    public View createView(Context context) {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back);
+        actionBar.setTitle(LocaleController.getString(R.string.ForkMainSettings));
+        actionBar.setActionBarMenuOnItemClick(new ActionBar.ActionBarMenuOnItemClick() {
+            @Override
+            public void onItemClick(int id) {
+                if (id == -1) {
+                    finishFragment();
+                }
+            }
+        });
+
+        FrameLayout frameLayout = new FrameLayout(context);
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray));
+        fragmentView = frameLayout;
+
+        listView = new RecyclerListView(context);
+        actionBar.setAdaptiveBackground(listView);
+        listView.setLayoutManager(new LinearLayoutManager(context));
+        listView.setVerticalScrollBarEnabled(false);
+        listView.setAdapter(adapter = new ListAdapter(context));
+        listView.setOnItemClickListener((v, position) -> {
+            if (position == ROW_ANIMATION) {
+                presentFragment(new ForkAnimationActivity());
+            }
+        });
+        frameLayout.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+
+        return fragmentView;
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        if (adapter != null) {
+            adapter.notifyDataSetChanged();
+        }
+    }
+
+    private CharSequence animationTitle() {
+        switch (ForkTuning.animationSpeed()) {
+            case ForkTuning.ANIM_SLOW: return LocaleController.getString(R.string.ForkAnimationSlow);
+            case ForkTuning.ANIM_NORMAL: return LocaleController.getString(R.string.ForkAnimationNormal);
+            case ForkTuning.ANIM_FAST: return LocaleController.getString(R.string.ForkAnimationFast);
+            case ForkTuning.ANIM_OFF: return LocaleController.getString(R.string.ForkAnimationOff);
+            default: return LocaleController.getString(R.string.ForkAnimationSystem);
+        }
+    }
+
+    private void toggle(int row, boolean value) {
+        switch (row) {
+            case ROW_NO_ROUND: ForkTuning.setNoRoundNumbers(value); break;
+            case ROW_SECONDS: ForkTuning.setShowSeconds(value); break;
+            case ROW_VIBRATION: ForkTuning.setVibration(value); break;
+        }
+        if (adapter != null) {
+            adapter.notifyDataSetChanged();
+        }
+    }
+
+    private CharSequence title(int row) {
+        switch (row) {
+            case ROW_NO_ROUND: return LocaleController.getString(R.string.ForkMainNoRound);
+            case ROW_SECONDS: return LocaleController.getString(R.string.ForkMainSeconds);
+            case ROW_VIBRATION: return LocaleController.getString(R.string.ForkMainVibration);
+        }
+        return "";
+    }
+
+    private boolean checked(int row) {
+        switch (row) {
+            case ROW_NO_ROUND: return ForkTuning.noRoundNumbers();
+            case ROW_SECONDS: return ForkTuning.showSeconds();
+            case ROW_VIBRATION: return ForkTuning.vibration();
+        }
+        return false;
+    }
+
+    private class SwitchHolder extends RecyclerListView.Holder {
+        final Switch toggle;
+
+        SwitchHolder(View itemView, Switch toggle) {
+            super(itemView);
+            this.toggle = toggle;
+        }
+    }
+
+    private class ListAdapter extends RecyclerListView.SelectionAdapter {
+        private final Context context;
+
+        private ListAdapter(Context context) {
+            this.context = context;
+        }
+
+        @Override
+        public int getItemCount() {
+            return ROW_COUNT + 1;
+        }
+
+        @Override
+        public boolean isEnabled(RecyclerView.ViewHolder holder) {
+            return !(holder instanceof SwitchHolder);
+        }
+
+        @NonNull
+        @Override
+        public RecyclerView.ViewHolder onCreateViewHolder(@NonNull ViewGroup parent, int viewType) {
+            View item;
+            if (viewType == TYPE_VALUE) {
+                TextSettingsCell cell = new TextSettingsCell(context);
+                cell.setCanDisable(false);
+                item = cell;
+            } else if (viewType == TYPE_SWITCH) {
+                FrameLayout container = new FrameLayout(context);
+                TextSettingsCell cell = new TextSettingsCell(context);
+                cell.setCanDisable(false);
+                cell.setText(LocaleController.getString(R.string.ForkMainPlaceholder), true);
+                container.addView(cell, new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+                Switch toggle = new Switch(context);
+                FrameLayout.LayoutParams toggleParams = new FrameLayout.LayoutParams(
+                        ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.CENTER_VERTICAL | Gravity.END);
+                toggleParams.rightMargin = AndroidUtilities.dp(16);
+                container.addView(toggle, toggleParams);
+                item = container;
+                item.setLayoutParams(new RecyclerView.LayoutParams(
+                        RecyclerView.LayoutParams.MATCH_PARENT, RecyclerView.LayoutParams.WRAP_CONTENT));
+                return new SwitchHolder(item, toggle);
+            }
+            item = new TextInfoPrivacyCell(context);
+            item.setLayoutParams(new RecyclerView.LayoutParams(
+                    RecyclerView.LayoutParams.MATCH_PARENT, RecyclerView.LayoutParams.WRAP_CONTENT));
+            return new RecyclerListView.Holder(item);
+        }
+
+        @Override
+        public void onBindViewHolder(@NonNull RecyclerView.ViewHolder holder, int position) {
+            if (position == ROW_COUNT) {
+                TextInfoPrivacyCell cell = (TextInfoPrivacyCell) holder.itemView;
+                cell.setText(LocaleController.getString(R.string.ForkMainInfo));
+                return;
+            }
+            if (position == ROW_ANIMATION) {
+                TextSettingsCell cell = (TextSettingsCell) holder.itemView;
+                cell.setTextAndValue(LocaleController.getString(R.string.ForkAnimationSpeed), animationTitle(), false);
+                return;
+            }
+            SwitchHolder switchHolder = (SwitchHolder) holder;
+            ((TextSettingsCell) ((FrameLayout) holder.itemView).getChildAt(0)).setText(title(position), true);
+            // Состояние выставляем до слушателя, иначе recycled-ячейка
+            // «щёлкнет» переключателем при прокрутке.
+            switchHolder.toggle.setOnCheckedChangeListener(null);
+            switchHolder.toggle.setChecked(checked(position));
+            switchHolder.toggle.setOnCheckedChangeListener((button, isChecked) -> {
+                if (isChecked != checked(position)) {
+                    toggle(position, isChecked);
+                }
+            });
+        }
+
+        @Override
+        public int getItemViewType(int position) {
+            if (position == ROW_COUNT) {
+                return TYPE_INFO;
+            }
+            return position == ROW_ANIMATION ? TYPE_VALUE : TYPE_SWITCH;
+        }
+    }
+}
