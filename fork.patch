@@ -0,0 +1,108 @@
+package org.telegram.messenger;
+
+/**
+ * Переключатели раздела «Основные». Значения читаются прямо из настроек,
+ * чтобы изменения применялись сразу, без кэша и перезапуска.
+ */
+public class ForkTuning {
+    private static final String PREFS = "fork_tuning";
+
+    private static final String KEY_NO_ROUND = "no_round_numbers";
+    private static final String KEY_SECONDS = "show_seconds";
+    private static final String KEY_VIBRATION = "vibration";
+    private static final String KEY_ANIMATION = "animation_speed";
+
+    private static boolean read(String key, boolean def) {
+        try {
+            return ApplicationLoader.applicationContext
+                    .getSharedPreferences(PREFS, android.content.Context.MODE_PRIVATE)
+                    .getBoolean(key, def);
+        } catch (Throwable ignore) {
+            return def;
+        }
+    }
+
+    private static void write(String key, boolean value) {
+        ApplicationLoader.applicationContext
+                .getSharedPreferences(PREFS, android.content.Context.MODE_PRIVATE)
+                .edit()
+                .putBoolean(key, value)
+                .apply();
+    }
+
+    /** 1234 показываем как «1234», а не «1.2K». */
+    public static boolean noRoundNumbers() {
+        return read(KEY_NO_ROUND, false);
+    }
+
+    public static void setNoRoundNumbers(boolean value) {
+        write(KEY_NO_ROUND, value);
+    }
+
+    /** Время с секундами: 12:34:56 вместо 12:34. */
+    public static boolean showSeconds() {
+        return read(KEY_SECONDS, false);
+    }
+
+    public static void setShowSeconds(boolean value) {
+        write(KEY_SECONDS, value);
+    }
+
+    /** Вибрация от нажатий внутри приложения. */
+    public static boolean vibration() {
+        return read(KEY_VIBRATION, true);
+    }
+
+    public static void setVibration(boolean value) {
+        write(KEY_VIBRATION, value);
+    }
+
+    public static final int ANIM_SYSTEM = 0;
+    public static final int ANIM_SLOW = 1;
+    public static final int ANIM_NORMAL = 2;
+    public static final int ANIM_FAST = 3;
+    public static final int ANIM_OFF = 4;
+
+    /** Скорость анимаций: как в системе / медленно / обычно / быстро / выкл. */
+    public static int animationSpeed() {
+        try {
+            return ApplicationLoader.applicationContext
+                    .getSharedPreferences(PREFS, android.content.Context.MODE_PRIVATE)
+                    .getInt(KEY_ANIMATION, ANIM_SYSTEM);
+        } catch (Throwable ignore) {
+            return ANIM_SYSTEM;
+        }
+    }
+
+    public static void setAnimationSpeed(int value) {
+        ApplicationLoader.applicationContext
+                .getSharedPreferences(PREFS, android.content.Context.MODE_PRIVATE)
+                .edit()
+                .putInt(KEY_ANIMATION, value)
+                .apply();
+        applyAnimationSettings();
+    }
+
+    /**
+     * Множитель для анимаций всего процесса. «Как в системе» (0) означает
+     * не трогать настройки Android — в том числе режим анимаций для
+     * доступности и «отключить анимации» в настройках разработчика.
+     */
+    public static float animationScale() {
+        switch (animationSpeed()) {
+            case ANIM_SLOW: return 1.5f;
+            case ANIM_NORMAL: return 1.0f;
+            case ANIM_FAST: return 0.6f;
+            case ANIM_OFF: return 0.0f;
+            default: return -1f;
+        }
+    }
+
+    /** Применяем сразу, чтобы переключатель был виден в действии. */
+    public static void applyAnimationSettings() {
+        try {
+            android.animation.ValueAnimator.setDurationScale(animationScale());
+        } catch (Throwable ignore) {
+        }
+    }
+}
