+    private View createForkRow(Context context, int colorTop, int colorBottom, int iconRes,
+            CharSequence titleText, CharSequence valueText, View.OnClickListener listener) {
+        LinearLayout row = new LinearLayout(context);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        row.setGravity(Gravity.CENTER_VERTICAL);
+        row.setPadding(dp(16), dp(11), dp(16), dp(11));
+        row.setBackground(Theme.AdaptiveRipple.createRect(0, 0xFF4FA9F5, dp(10)));
+        row.setOnClickListener(listener);
+
+        GradientDrawable circle = new GradientDrawable(GradientDrawable.Orientation.TL_BR,
+                new int[]{colorTop, colorBottom});
+        circle.setShape(GradientDrawable.OVAL);
+        ImageView icon = new ImageView(context);
+        icon.setBackground(circle);
+        icon.setImageResource(iconRes);
+        icon.setPadding(dp(5), dp(5), dp(5), dp(5));
+        row.addView(icon, new LinearLayout.LayoutParams(dp(24), dp(24)));
+
+        TextView title = new TextView(context);
+        title.setText(titleText);
+        title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider));
