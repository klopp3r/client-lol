diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/ForkDiagnostics.java b/TMessagesProj/src/main/java/org/telegram/messenger/ForkDiagnostics.java
new file mode 100644
index 0000000..c7cbeaf
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ForkDiagnostics.java
@@ -0,0 +1,103 @@
+package org.telegram.messenger;
+
+import android.content.Context;
+import android.content.SharedPreferences;
+import android.text.TextUtils;
+import android.util.Log;
+
+/**
+ * Простейший встроенный отчёт о падениях.
+ * <p>
+ * Форк ставится вручную, и у пользователя нет удобного способа снять logcat,
+ * поэтому текст последнего падения сохраняется рядом с настройками форка и
+ * показывается в Настройках отдельным пунктом. Если запись пустая, значит
+ * приложение упало нативно (внутри .so) либо было убито системой, — тогда
+ * обработчик не срабатывает, и это само по себе полезный сигнал.
+ */
+public class ForkDiagnostics {
+    public static final String TAG = "ForkDiagnostics";
+
+    private static final String PREFS = "fork_diagnostics";
+    private static final String KEY_ERROR = "last_error";
+    private static final String KEY_START = "last_start";
+    private static final int MAX_LENGTH = 4000;
+
+    private static boolean installed;
+
+    public static synchronized void install(Context context) {
+        final Context appContext = context.getApplicationContext();
+        prefs(appContext).edit().putLong(KEY_START, System.currentTimeMillis()).apply();
+        if (installed) {
+            return;
+        }
+        installed = true;
+        final Thread.UncaughtExceptionHandler previous = Thread.getDefaultUncaughtExceptionHandler();
+        Thread.setDefaultUncaughtExceptionHandler((thread, throwable) -> {
+            try {
+                record(appContext, throwable);
+            } catch (Throwable ignored) {
+                // Запись отчёта не должна сама что-то сломать.
+            }
+            if (previous != null) {
+                previous.uncaughtException(thread, throwable);
+            } else {
+                android.os.Process.killProcess(android.os.Process.myPid());
+            }
+        });
+    }
+
+    private static void record(Context context, Throwable throwable) {
+        String text = Log.getStackTraceString(throwable);
+        if (text.length() > MAX_LENGTH) {
+            text = text.substring(0, MAX_LENGTH);
+        }
+        prefs(context).edit().putString(KEY_ERROR, text).commit();
+    }
+
+    /** Записывает ошибку вручную, если поймать её не удалось. */
+    public static void record(Context context, String text) {
+        record(context, new RuntimeException(text));
+    }
+
+    public static String getLastError(Context context) {
+        return prefs(context).getString(KEY_ERROR, "");
+    }
+
+    public static long getLastStart(Context context) {
+        return prefs(context).getLong(KEY_START, 0);
+    }
+
+    public static void clear(Context context) {
+        prefs(context).edit().remove(KEY_ERROR).apply();
+    }
+
+    private static SharedPreferences prefs(Context context) {
+        return (context.getApplicationContext() != null ? context.getApplicationContext() : context).getSharedPreferences(PREFS, Context.MODE_PRIVATE);
+    }
+
+    /** Человекочитаемая сводка для строки настроек. */
+    public static String summary(Context context) {
+        if (context == null) {
+            return "";
+        }
+        String error = getLastError(context);
+        if (!TextUtils.isEmpty(error)) {
+            return shortReason(error);
+        }
+        long start = getLastStart(context);
+        if (start <= 0) {
+            return "";
+        }
+        return android.text.format.DateFormat.getTimeFormat(context)
+                .format(new java.util.Date(start));
+    }
+
+    private static String shortReason(String error) {
+        int newline = error.indexOf('\n');
+        String first = newline > 0 ? error.substring(0, newline) : error;
+        if (first.length() > 60) {
+            first = first.substring(0, 60) + "…";
+        }
+        return first;
+    }
+}
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/ForkGhost.java b/TMessagesProj/src/main/java/org/telegram/messenger/ForkGhost.java
new file mode 100644
index 0000000..9c268d6
--- /dev/null
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ForkGhost.java
@@ -0,0 +1,176 @@
+package org.telegram.messenger;
+
+import android.app.Activity;
+import android.app.Application;
+import android.os.Bundle;
+
+import java.util.concurrent.atomic.AtomicInteger;
+
+/**
+ * Хранилище настроек «режима призрака». Значения читаются напрямую из
+ * MessagesController, поэтому всё держим на SharedPreferences без
+ * статического кэша: переключатель должен действовать сразу.
+ */
+public class ForkGhost {
+    private static final String PREFS = "fork_ghost";
+
+    private static final String KEY_ENABLED = "enabled";
+    private static final String KEY_READ = "block_read";
+    private static final String KEY_HISTORY = "block_history";
+    private static final String KEY_ONLINE = "block_online";
+    private static final String KEY_TYPING = "block_typing";
+    private static final String KEY_AUTO_OFFLINE = "auto_offline";
+
+    private static final AtomicInteger startedActivities = new AtomicInteger();
+    private static volatile boolean backgrounded;
+
+    private static boolean read(String key, boolean def) {
+        try {
+            return ApplicationLoader.applicationContext
+                    .getSharedPreferences(PREFS, android.content.Context.MODE_PRIVATE)
+                    .getBoolean(key, def);
+        } catch (Throwable ignore) {
+            return def;
+        }
+    }
+
+    private static void write(String key, boolean value) {
+        ApplicationLoader.applicationContext
+                .getSharedPreferences(PREFS, android.content.Context.MODE_PRIVATE)
+                .edit()
+                .putBoolean(key, value)
+                .apply();
+    }
+
+    /** Главный переключатель: выключен — все остальные пункты игнорируются. */
+    public static boolean isEnabled() {
+        return read(KEY_ENABLED, false);
+    }
+
+    public static void setEnabled(boolean value) {
+        write(KEY_ENABLED, value);
+    }
+
+    // Дальше — «сырые» значения без учёта главного переключателя:
+    // так переключатели в настройках показывают сохранённое состояние.
+
+    public static boolean isBlockRead() {
+        return read(KEY_READ, true);
+    }
+
+    public static void setBlockRead(boolean value) {
+        write(KEY_READ, value);
+    }
+
+    public static boolean isBlockHistory() {
+        return read(KEY_HISTORY, true);
+    }
+
+    public static void setBlockHistory(boolean value) {
+        write(KEY_HISTORY, value);
+    }
+
+    public static boolean isBlockOnline() {
+        return read(KEY_ONLINE, false);
+    }
+
+    public static void setBlockOnline(boolean value) {
+        write(KEY_ONLINE, value);
+    }
+
+    public static boolean isBlockTyping() {
+        return read(KEY_TYPING, true);
+    }
+
+    public static void setBlockTyping(boolean value) {
+        write(KEY_TYPING, value);
+    }
+
+    public static boolean isAutoOffline() {
+        return read(KEY_AUTO_OFFLINE, false);
+    }
+
+    public static void setAutoOffline(boolean value) {
+        write(KEY_AUTO_OFFLINE, value);
+    }
+
+    /** Не отправлять прочтения: собеседник видит только «доставлено». */
+    public static boolean blockRead() {
+        return isEnabled() && read(KEY_READ, true);
+    }
+
+    /** Не качать историю с сервера и не отправлять «содержимое просмотрено». */
+    public static boolean blockHistory() {
+        return isEnabled() && read(KEY_HISTORY, true);
+    }
+
+    /** «Печатает…» не отправляется. */
+    public static boolean blockTyping() {
+        return isEnabled() && read(KEY_TYPING, true);
+    }
+
+    /**
+     * Полная скрытность: даже если отдельные пункты выключены, активность
+     * не отправляется. В этой сборке нет отдельного запроса статуса —
+     * Telegram считает «в сети» любую активность клиента.
+     */
+    public static boolean blockOnline() {
+        return isEnabled() && read(KEY_ONLINE, false);
+    }
+
+    /** Сразу «оффлайн» после сворачивания приложения. */
+    public static boolean autoOffline() {
+        return isEnabled() && read(KEY_AUTO_OFFLINE, false);
+    }
+
+    /** Никакой активности: ни прочтений, ни «печатает». */
+    public static boolean suppressActivity() {
+        return blockOnline() || (autoOffline() && backgrounded);
+    }
+
+    public static boolean isBackgrounded() {
+        return backgrounded;
+    }
+
+    public static void init(Application application) {
+        if (application == null) {
+            return;
+        }
+        application.registerActivityLifecycleCallbacks(new Application.ActivityLifecycleCallbacks() {
+            @Override
+            public void onActivityStarted(Activity activity) {
+                startedActivities.incrementAndGet();
+                backgrounded = false;
+            }
+
+            @Override
+            public void onActivityStopped(Activity activity) {
+                int left = startedActivities.decrementAndGet();
+                if (left <= 0) {
+                    startedActivities.set(0);
+                    backgrounded = true;
+                }
+            }
+
+            @Override
+            public void onActivityCreated(Activity activity, Bundle savedInstanceState) {
+            }
+
+            @Override
+            public void onActivityResumed(Activity activity) {
+            }
+
+            @Override
+            public void onActivityPaused(Activity activity) {
+            }
+
+            @Override
+            public void onActivitySaveInstanceState(Activity activity, Bundle outState) {
+            }
+
+            @Override
+            public void onActivityDestroyed(Activity activity) {
+            }
+        });
+    }
+}
